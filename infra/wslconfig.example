# WSL2 Memory Configuration for ConversX Local-First Development
#
# INSTRUCTIONS:
#   Place this file at: C:\Users\anand\.wslconfig
#   Then in PowerShell: wsl --shutdown
#   Then restart Docker Desktop.
#
# Memory Sizing Architecture:
#   Sum of Docker container service limits in docker-compose.yml:
#     - postgres:     512 MB
#     - redis:        192 MB
#     - api:         1536 MB
#     - worker:      3584 MB
#     - ollama:      2560 MB
#     - prometheus:   384 MB
#     - uptime-kuma:  256 MB
#     Total service limits = 9024 MB (~8.8 GiB / 9.0 GB).
#
#   WSL2 VM Memory Setting:
#     The Linux kernel (vmlinux), systemd/init, Docker daemon (dockerd/containerd),
#     and page cache require roughly 1.0 - 1.5 GB of operating overhead.
#     If WSL2 memory is capped at 9 GB, the host WSL2 kernel will trigger OOM kills
#     on background daemons before container limits are truthfully reached.
#     Therefore, .wslconfig is set to 10.5 GB (or 11 GB on a 16+ GB host machine),
#     comfortably above the 9024 MB container limits.
#
#   Gate A Benchmark Enforcement:
#     The benchmark threshold measured via `docker stats` is strictly evaluated
#     at 8.5 GB (8704 MB sum of active container RSS), preserving the Gate A criterion.
#
[wsl2]
# 2 virtual CPUs - matches the 2 OCPU target
processors=2

# 10.5 GB total WSL2 memory - comfortably above the 9024 MB container limits
# to prevent kernel-level OOM kills while leaving 8.5 GB gate headroom.
memory=10.5GB

# 4 GB swap - required by §6 ("Add a 4 GB swap file")
swap=4GB

# Prevent WSL2 from consuming host memory aggressively
pageReporting=true

# Keep WSL2 VM alive between Docker commands
localhostForwarding=true
