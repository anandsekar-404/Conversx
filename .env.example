# =============================================================================
# ConversX — Environment Variables Template
# Copy to .env (chmod 600 on Linux). NEVER commit .env.
# All secrets must be provided as environment variables or Docker secrets.
# Placeholder values are marked with CHANGE_ME.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development                        # development | test | production
APP_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
APP_DOMAIN=conversx.example               # placeholder; set conversx.com at Gate B
APP_URL=https://app.conversx.example
ADMIN_URL=https://admin.conversx.example
API_URL=https://api.conversx.example

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=conversx
POSTGRES_USER=conversx
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---------------------------------------------------------------------------
# Redis / RQ
# ---------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---------------------------------------------------------------------------
# Auth — JWT / Cookies
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_64
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_DOMAIN=.conversx.example           # set to .conversx.com at Gate B
COOKIE_SECURE=false                       # set to true in production (HTTPS only)

# ---------------------------------------------------------------------------
# CORS / CSRF
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://app.conversx.example,https://admin.conversx.example
CSRF_COOKIE_NAME=conversx-csrf

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (signup protection)
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# Cloudflare Access (admin JWT verification)
# ---------------------------------------------------------------------------
CF_ACCESS_TEAM_DOMAIN=CHANGE_ME.cloudflareaccess.com
CF_ACCESS_AUDIENCE=CHANGE_ME

# ---------------------------------------------------------------------------
# Brevo (transactional email)
# ---------------------------------------------------------------------------
BREVO_API_KEY=CHANGE_ME
BREVO_FROM_EMAIL=noreply@conversx.example
BREVO_FROM_NAME=ConversX
BREVO_DAILY_CAP_GUARD=210                 # 70% of 300 free limit; fail gracefully above this

# ---------------------------------------------------------------------------
# AI — faster-whisper (STT)
# ---------------------------------------------------------------------------
WHISPER_MODEL=small                       # base | small; set by Gate A benchmark
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_MODEL_DIR=/models/whisper

# ---------------------------------------------------------------------------
# AI — Ollama (LLM)
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b                   # set by Gate A benchmark
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
LLM_MAX_TOKENS_OUT=150
LLM_TEMPERATURE=0.7
LLM_REWRITE_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30                   # fallback to scripted if exceeded

# ---------------------------------------------------------------------------
# AI — Moderation (Detoxify)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Quotas (server-side enforcement)
# ---------------------------------------------------------------------------
STT_MINUTES_PER_USER_PER_DAY=30
LLM_REQUESTS_PER_USER_PER_DAY=50
MAX_AUDIO_CLIP_SECONDS=60                 # adjusted from Week 1 RTF benchmark

# ---------------------------------------------------------------------------
# Storage — Cloudflare R2 / Backblaze B2 (backups)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=CHANGE_ME
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET=conversx-backups
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Optional second copy (Backblaze B2)
B2_KEY_ID=CHANGE_ME
B2_APPLICATION_KEY=CHANGE_ME
B2_BUCKET=conversx-backups-b2

# ---------------------------------------------------------------------------
# Backup — age encryption
# ---------------------------------------------------------------------------
AGE_RECIPIENT=CHANGE_ME_age_public_key    # age-keygen -o key.txt → paste public key here
HEALTHCHECK_PING_URL=CHANGE_ME            # dead-man's-switch URL

# ---------------------------------------------------------------------------
# Monitoring — Prometheus
# ---------------------------------------------------------------------------
PROMETHEUS_METRICS_PORT=9090             # internal only, not exposed to internet

# ---------------------------------------------------------------------------
# Cloudflare Tunnel (set on server at Gate B)
# ---------------------------------------------------------------------------
TUNNEL_TOKEN=CHANGE_ME                   # cloudflared tunnel token

# ---------------------------------------------------------------------------
# GitHub Container Registry (CI)
# ---------------------------------------------------------------------------
GHCR_IMAGE=ghcr.io/CHANGE_ME/conversx/backend


# Moderation - Firebase Rule-Based Database
FIREBASE_PROJECT_ID=conversx-moderation
FIREBASE_CREDENTIALS_PATH=          # Path to service account JSON if using admin SDK

# ---------------------------------------------------------------------------
# Vercel Frontend & Production Integration
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.conversx.com       # Production API URL (set in Vercel project env)
CORS_ORIGINS=https://conversx.vercel.app,http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Whisper Speech-to-Text (Oracle Cloud VM)
# ---------------------------------------------------------------------------
WHISPER_MODEL=small                             # tiny | base | small | medium
WHISPER_DEVICE=cpu                              # cpu | cuda
WHISPER_COMPUTE_TYPE=int8                       # int8 for CPU, float16 for CUDA

# ---------------------------------------------------------------------------
# Administration & Safety Governance
# ---------------------------------------------------------------------------
ADMIN_API_KEY=CHANGE_ME_long_random_admin_secret_key
